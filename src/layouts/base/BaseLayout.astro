---
import '@styles/index.css';
import notoSansScStylesheet from '@fontsource-variable/noto-sans-sc/index.css?url';
import notoSansJpStylesheet from '@fontsource-variable/noto-sans-jp/index.css?url';
import notoSansStylesheet from '@fontsource-variable/noto-sans/index.css?url';
import GoogleAnalytics from '@components/utils/GoogleAnalytics.astro';
import ResponsiveImage from '@components/common/ResponsiveImage.astro';
import { ClientRouter } from 'astro:transitions';
import type { AlternateLink } from '@lib/i18n';

interface Props {
    siteTitle: string;
    pageTitle?: string;
    coverImageUrl: URL | string | null;
    lang?: string;
    canonicalUrl?: string;
    alternateLinks?: AlternateLink[];
    /** 当前页面的语言代码 (用于 RSS 发现) */
    locale?: 'zh' | 'ja' | 'en';
    /** SSR 阶段写入文章浏览模式，避免 Navbar 次级控件在水合前闪现。 */
    initialPostViewMode?: 'gallery' | 'list';
}

const {
    siteTitle,
    pageTitle,
    coverImageUrl,
    lang = 'zh-CN',
    canonicalUrl,
    alternateLinks = [],
    locale = 'zh',
    initialPostViewMode,
} = Astro.props;

const documentTitle = pageTitle ? `${pageTitle} · ${siteTitle}` : siteTitle;
const fontStylesheet = {
    zh: notoSansScStylesheet,
    ja: notoSansJpStylesheet,
    en: notoSansStylesheet,
}[locale];
const skipToContentLabel = {
    zh: '跳到主要内容',
    ja: '本文へスキップ',
    en: 'Skip to main content',
}[locale];

// RSS Feed URLs
const rssCurrentLang = `/${locale}/rss.xml`;
const rssAll = '/rss.xml';

const coverImageSrc = coverImageUrl?.toString() ?? '';
const imageOrigin = (() => {
    if (!coverImageUrl) return '';
    try {
        return new URL(coverImageUrl.toString()).origin;
    } catch {
        return '';
    }
})();
---

<!doctype html>
<html lang={lang} data-post-view-mode={initialPostViewMode} data-media-card-protocol="v2">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        {imageOrigin && <link rel="preconnect" href={imageOrigin} crossorigin="anonymous" />}
        <link rel="stylesheet" href={fontStylesheet} data-solitude-font={locale} />
        <meta name="generator" content={Astro.generator} />

        <!-- Security Headers -->
        <meta http-equiv="X-Content-Type-Options" content="nosniff" />
        <meta http-equiv="X-Frame-Options" content="SAMEORIGIN" />
        <meta name="referrer" content="strict-origin-when-cross-origin" />
        <meta
            http-equiv="Content-Security-Policy"
            content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'self';"
        />

        {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
        {
            alternateLinks.map((link) => (
                <link rel="alternate" hreflang={link.hreflang} href={link.href} />
            ))
        }

        <!-- RSS Feed Discovery -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title={`${siteTitle} RSS Feed`}
            href={rssCurrentLang}
        />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={`${siteTitle} RSS Feed (All Languages)`}
            href={rssAll}
        />

        <GoogleAnalytics />
        <title>{documentTitle}</title>
        <script is:inline>
            (() => {
                const STORAGE_KEY = 'theme';
                const THEME_ATTRIBUTE = 'data-theme';
                const TOGGLE_SELECTOR = '[data-theme-switch]';
                const THEMES = new Set(['dark', 'light']);

                const isTheme = (value) => THEMES.has(value);

                const parseTheme = (stored) => {
                    if (!stored) return 'dark';
                    if (isTheme(stored)) return stored;
                    try {
                        const parsed = JSON.parse(stored);
                        return isTheme(parsed) ? parsed : 'dark';
                    } catch {
                        return 'dark';
                    }
                };

                const getStoredTheme = () => {
                    try {
                        return parseTheme(localStorage.getItem(STORAGE_KEY));
                    } catch {
                        return 'dark';
                    }
                };

                const getDocumentTheme = () => {
                    const root = document.documentElement;
                    const attributeTheme = root.getAttribute(THEME_ATTRIBUTE);
                    if (isTheme(attributeTheme)) return attributeTheme;
                    if (root.classList.contains('light')) return 'light';
                    if (root.classList.contains('dark')) return 'dark';
                    return getStoredTheme();
                };

                const syncControls = (target, theme) => {
                    const isLight = theme === 'light';
                    const state = isLight ? 'checked' : 'unchecked';

                    target.querySelectorAll(TOGGLE_SELECTOR).forEach((button) => {
                        button.setAttribute('aria-checked', String(isLight));
                        button.setAttribute(
                            'aria-label',
                            isLight ? 'Switch to dark theme' : 'Switch to light theme'
                        );
                        button.setAttribute('data-state', state);
                        button
                            .querySelector('[data-theme-switch-thumb]')
                            ?.setAttribute('data-state', state);
                    });
                };

                const syncDocument = (target, theme = getDocumentTheme()) => {
                    const root = target.documentElement;
                    root.setAttribute(THEME_ATTRIBUTE, theme);
                    root.classList.toggle('dark', theme === 'dark');
                    root.classList.toggle('light', theme === 'light');
                    root.style.colorScheme = theme;
                    syncControls(target, theme);
                    return theme;
                };

                const applyTheme = (theme, options = {}) => {
                    if (!isTheme(theme)) return getDocumentTheme();

                    const { persist = true, notify = true } = options;
                    syncDocument(document, theme);

                    if (persist) {
                        try {
                            localStorage.setItem(STORAGE_KEY, theme);
                        } catch {
                            // The active document still keeps the selected theme.
                        }
                    }

                    if (notify) {
                        window.dispatchEvent(
                            new CustomEvent('themeChanged', {
                                detail: { theme },
                            })
                        );
                    }

                    return theme;
                };

                if (!window.__solitudeTheme) {
                    window.__solitudeTheme = {
                        getTheme: getDocumentTheme,
                        applyTheme,
                        syncDocument,
                        syncControls(target = document, theme = getDocumentTheme()) {
                            syncControls(target, theme);
                        },
                        toggleTheme() {
                            return applyTheme(getDocumentTheme() === 'light' ? 'dark' : 'light');
                        },
                    };

                    document.addEventListener('astro:before-swap', (event) => {
                        const nextDocument = event.newDocument;
                        if (!nextDocument) return;
                        window.__solitudeTheme?.syncDocument(
                            nextDocument,
                            window.__solitudeTheme.getTheme()
                        );
                    });

                    window.addEventListener('themeChanged', (event) => {
                        const theme = event.detail?.theme;
                        if (!isTheme(theme)) return;
                        if (getDocumentTheme() === theme) return;
                        syncDocument(document, theme);
                    });
                }

                window.__solitudeTheme.applyTheme(getStoredTheme(), {
                    persist: false,
                    notify: false,
                });
            })();
        </script>
        <ClientRouter fallback="animate" />
    </head>
    <body>
        <a class="site-skip-link" href="#site-main-content">{skipToContentLabel}</a>
        <div class="solitude-body" transition:persist="site-background">
            {
                coverImageSrc && (
                    <ResponsiveImage
                        src={coverImageSrc}
                        alt=""
                        widths={[480, 960, 1440, 1920, 2560, 3840]}
                        sizes="100vw"
                        quality={100}
                        priority
                        critical
                        progressive
                        className="solitude-body-image"
                    />
                )
            }
        </div>
        <slot />
    </body>
</html>

<style>
    .site-skip-link {
        position: fixed;
        top: 0.75rem;
        left: var(--site-page-gutter);
        z-index: 10000;
        display: inline-flex;
        min-height: 2.5rem;
        align-items: center;
        padding: 0.55rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--background);
        color: var(--foreground);
        font-size: 0.875rem;
        font-weight: 700;
        box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.24);
        opacity: 0;
        pointer-events: none;
        transform: translateY(calc(-100% - 1rem));
        transition:
            opacity var(--top-control-motion-fast) var(--top-control-ease),
            transform var(--top-control-motion-state) var(--top-control-ease);
    }

    .site-skip-link:focus-visible {
        outline: 2px solid var(--ring);
        outline-offset: 2px;
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    .solitude-body {
        top: 0;
        left: 0;
        position: fixed;
        z-index: -10;
        height: 100vh;
        width: 100vw;
        isolation: isolate;
        overflow: hidden;
        background-color: var(--background);
    }

    .solitude-body :global(.solitude-body-image) {
        position: absolute;
        inset: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
    }

    /* 遮罩层使用伪元素：上浅下深渐变 + 暗角效果 */
    .solitude-body::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
        background:
            /* 径向暗角 - 四周略深，聚焦视觉中心 */
            radial-gradient(
                ellipse 120% 100% at 50% 50%,
                transparent 0%,
                transparent 50%,
                var(--site-bg-vignette) 100%
            ),
            /* 上浅下深线性渐变 - 让下半屏卡片对比更稳定 */
            linear-gradient(
                    to bottom,
                    var(--site-bg-overlay-top) 0%,
                    var(--site-bg-overlay-bottom) 100%
                );
        pointer-events: none;
    }
</style>

<script>
    import { initSiteNavigationMotion } from '@lib/navigation/transitionCoordinator';

    initSiteNavigationMotion();
</script>
