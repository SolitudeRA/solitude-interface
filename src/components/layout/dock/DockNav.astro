---
import DockNavMobile from './DockNavMobile.astro';
import RssSelector from '@components/common/RssSelector.astro';
import { type Locale, DEFAULT_LOCALE, buildLocalePath } from '@lib/i18n';
import { isCurrentDockDestination } from '@lib/navigation/dockNavigationGuard';

interface Props {
    lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

// 构建多语言链接
const homeLink = `/${lang}`;
const postsLink = buildLocalePath(lang, 'post-view');
const aboutLink = buildLocalePath(lang, 'about');
const contactLink = buildLocalePath(lang, 'contact');
const privacyLink = buildLocalePath(lang, 'privacy-policy');

const homeLabel = 'Home';
const postsLabel = 'Posts';
const aboutLabel = 'About';
const contactLabel = 'Contact';
const privacyLabel = 'Privacy';
const isCurrentRoute = (href: string) =>
    isCurrentDockDestination(Astro.url, new URL(href, Astro.url));
---

<!-- 移动端汉堡菜单 - 小于768px -->
<div class="flex justify-center md:hidden">
    <DockNavMobile lang={lang} />
</div>

<!-- 桌面端导航栏 - 768px及以上 -->
<div class="hidden md:grid md:justify-items-center">
    <div
        data-dock-nav
        class:list={[
            'dock-nav',
            'text-color-ui flex items-center',
            'h-10 md:h-11 lg:h-12 xl:h-14',
            'min-h-[2.5rem] md:min-h-[2.75rem] lg:min-h-[3rem]',
            'w-auto max-w-full',
        ]}
    >
        <div class="dock-nav-item-left">
            <a
                href={homeLink}
                data-dock-route
                data-astro-prefetch="hover"
                aria-current={isCurrentRoute(homeLink) ? 'page' : undefined}
                class="dock-nav-link text-xs font-medium whitespace-nowrap md:text-sm lg:text-base"
                >{homeLabel}</a
            >
        </div>
        <div class="dock-nav-item">
            <a
                href={postsLink}
                data-dock-route
                data-astro-prefetch="hover"
                aria-current={isCurrentRoute(postsLink) ? 'page' : undefined}
                class="dock-nav-link text-xs font-medium whitespace-nowrap md:text-sm lg:text-base"
                >{postsLabel}</a
            >
        </div>
        <div class="dock-nav-item">
            <a
                href={aboutLink}
                data-dock-route
                data-astro-prefetch="hover"
                aria-current={isCurrentRoute(aboutLink) ? 'page' : undefined}
                class="dock-nav-link text-xs font-medium whitespace-nowrap md:text-sm lg:text-base"
                >{aboutLabel}</a
            >
        </div>
        <!-- Contact - md 时为右侧，lg+ 时为普通 -->
        <div class="dock-nav-item dock-nav-item-right-md">
            <a
                href={contactLink}
                data-dock-route
                data-astro-prefetch="hover"
                aria-current={isCurrentRoute(contactLink) ? 'page' : undefined}
                class="dock-nav-link text-xs font-medium whitespace-nowrap md:text-sm lg:text-base"
                >{contactLabel}</a
            >
        </div>
        <!-- RSS 选择器 - lg 时为右侧，xl 时为普通 -->
        <div class="dock-nav-item dock-nav-item-right-lg hidden lg:flex">
            <RssSelector showLabel={true} textLocale="en" />
        </div>
        <!-- Privacy Policy 仅在大屏显示，xl+ 为右侧 -->
        <div class="dock-nav-item-right hidden xl:flex">
            <a
                href={privacyLink}
                data-dock-route
                data-astro-prefetch="hover"
                aria-current={isCurrentRoute(privacyLink) ? 'page' : undefined}
                class="dock-nav-link text-xs font-medium whitespace-nowrap md:text-sm lg:text-base"
                >{privacyLabel}</a
            >
        </div>
    </div>
</div>

<script>
    import { initDockNavigationGuard } from '@lib/navigation/dockNavigationGuard';

    // 方向感知下划线效果
    function initDirectionalUnderline() {
        const items = document.querySelectorAll('.dock-nav-item');

        items.forEach((item) => {
            const link = item.querySelector('.dock-nav-link');
            if (!link) return;

            item.addEventListener('mouseenter', (e) => {
                const rect = item.getBoundingClientRect();
                const mouseX = (e as MouseEvent).clientX;
                const centerX = rect.left + rect.width / 2;

                // 根据鼠标进入位置判断方向
                const direction = mouseX < centerX ? 'left' : 'right';
                link.setAttribute('data-direction', direction);
            });
        });
    }

    // 页面加载时初始化
    initDirectionalUnderline();
    initDockNavigationGuard();

    // 支持 Astro 视图过渡
    document.addEventListener('astro:after-swap', initDirectionalUnderline);
</script>
