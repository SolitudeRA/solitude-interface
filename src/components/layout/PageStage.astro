---
interface Props {
    variant: 'home' | 'posts' | 'content' | 'article';
    transitionKey?: 'home' | 'posts' | 'about' | 'contact' | 'privacy' | 'article';
    class?: string;
}

const { variant, transitionKey = variant, class: className } = Astro.props;
const transitionName = `site-page-stage-${transitionKey}`;
---

<main
    id="site-main-content"
    tabindex="-1"
    data-site-main-content
    data-page-stage={variant}
    class:list={['site-page-stage', className]}
    transition:name={transitionName}
>
    <slot />
</main>

<style>
    .site-page-stage {
        position: relative;
        width: 100%;
        min-width: 0;
        outline: none;
    }

    .site-page-stage[data-page-stage='article'] {
        padding-bottom: calc(var(--site-dock-height) + 1rem);
    }
</style>
