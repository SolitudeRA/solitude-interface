---
import ResponsiveImage from '@components/common/ResponsiveImage.astro';

interface Props {
    logoImageUrl: string;
    siteTitle: string;
    siteSubTitle: string;
    homeUrl?: string;
    hideTitleOnMobile?: boolean;
}

const {
    logoImageUrl,
    siteTitle,
    siteSubTitle,
    homeUrl = '/',
    hideTitleOnMobile = false,
} = Astro.props;
const hasLogo = logoImageUrl && logoImageUrl.length > 0;
---

<a
    href={homeUrl}
    data-astro-prefetch="hover"
    class="navbar-brand site-navbar-brand cursor-pointer no-underline"
    data-navbar-brand
    data-navbar-brand-hide-mobile={hideTitleOnMobile ? 'true' : 'false'}
>
    {
        hasLogo && (
            <ResponsiveImage
                src={logoImageUrl}
                alt=""
                widths={[48, 64, 96, 128]}
                sizes="(max-width: 639px) 48px, 68px"
                quality={90}
                priority
                className="site-navbar-logo"
            />
        )
    }
    <div class="site-navbar-brand-copy text-color-ui">
        <span class="site-title site-navbar-title font-bold subpixel-antialiased">{siteTitle}</span>
        <span class="site-subtitle site-navbar-subtitle font-medium subpixel-antialiased"
            >{siteSubTitle}</span
        >
    </div>
</a>

<style>
    .site-title {
        color: var(--text-site-title);
    }

    .site-subtitle {
        color: var(--text-site-subtitle);
    }
</style>
