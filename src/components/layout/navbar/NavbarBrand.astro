---
import ResponsiveImage from '@components/common/ResponsiveImage.astro';

interface Props {
    logoImageUrl: string;
    siteTitle: string;
    siteSubTitle: string;
    homeUrl?: string;
    hideTitleOnMobile?: boolean;
}

const {
    logoImageUrl,
    siteTitle,
    siteSubTitle,
    homeUrl = '/',
    hideTitleOnMobile = false,
} = Astro.props;
const hasLogo = logoImageUrl && logoImageUrl.length > 0;
---

<a
    href={homeUrl}
    data-astro-prefetch="hover"
    class:list={[
        'navbar-brand flex h-full items-center',
        'space-x-4 sm:space-x-6 md:space-x-8 lg:space-x-10',
        'px-4 sm:px-6 md:px-8 lg:px-10',
        'cursor-pointer no-underline',
    ]}
>
    {
        hasLogo && (
            <ResponsiveImage
                src={logoImageUrl}
                alt=""
                widths={[48, 80, 120, 160, 200]}
                sizes="(max-width: 639px) 48px, (max-width: 1023px) 80px, 100px"
                quality={80}
                priority
                className="h-2/5 min-h-10 w-auto rounded-[18%] sm:h-[45%] sm:min-h-16 md:h-1/2 md:min-h-20 lg:min-h-25"
            />
        )
    }
    <div class="text-color-ui grid grid-cols-1 gap-1 sm:gap-2 md:gap-3">
        <span
            class:list={[
                'site-title font-bold subpixel-antialiased',
                'text-xl sm:text-2xl md:text-3xl lg:text-4xl',
                hideTitleOnMobile && 'hidden sm:inline',
            ]}>{siteTitle}</span
        >
        <span
            class:list={[
                'site-subtitle font-medium subpixel-antialiased',
                'text-xs sm:text-sm md:text-base lg:text-xl',
                'hidden sm:block',
            ]}>{siteSubTitle}</span
        >
    </div>
</a>

<style>
    .site-title {
        color: var(--text-site-title);
    }

    .site-subtitle {
        color: var(--text-site-subtitle);
    }
</style>
