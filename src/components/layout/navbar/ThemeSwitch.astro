<button
    type="button"
    role="switch"
    aria-checked="false"
    aria-label="Switch to light theme"
    data-theme-switch
    data-state="unchecked"
    class:list={[
        'peer inline-flex h-8 w-14 shrink-0 cursor-pointer items-center rounded-full',
        'border transition-all duration-300',
        'border-[var(--top-control-border)] bg-[var(--top-control-bg)] text-[var(--top-control-text)]',
        'shadow-[0_8px_24px_var(--top-control-shadow)] hover:bg-[var(--top-control-bg-hover)] hover:shadow-[0_10px_28px_var(--top-control-shadow-hover)]',
        'focus-visible:ring-ring focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none',
    ]}
>
    <span
        data-theme-switch-thumb
        data-state="unchecked"
        class:list={[
            'pointer-events-none flex h-6 w-6 items-center justify-center rounded-full',
            'transition-all duration-300',
            'bg-[var(--top-control-thumb-bg)] text-[var(--top-control-thumb-text)]',
            'shadow-[0_6px_18px_var(--top-control-thumb-shadow)]',
        ]}
    >
        <svg
            data-theme-switch-icon="sun"
            class="h-4 w-4 text-current transition-transform duration-300"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg
            data-theme-switch-icon="moon"
            class="h-4 w-4 text-current transition-transform duration-300"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path
                d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
            ></path>
        </svg>
    </span>
</button>

<style>
    [data-theme-switch-thumb] {
        transform: translateX(0.25rem);
    }

    :global(html[data-theme='light']) [data-theme-switch-thumb] {
        transform: translateX(1.75rem);
    }

    [data-theme-switch-icon='sun'] {
        display: none;
    }

    [data-theme-switch-icon='moon'] {
        display: block;
    }

    :global(html[data-theme='light']) [data-theme-switch-icon='sun'] {
        display: block;
    }

    :global(html[data-theme='light']) [data-theme-switch-icon='moon'] {
        display: none;
    }
</style>

<script is:inline>
    (() => {
        const TOGGLE_SELECTOR = '[data-theme-switch]';

        const bindToggle = (button) => {
            if (
                !(button instanceof HTMLButtonElement) ||
                button.dataset.themeSwitchBound === 'true'
            ) {
                return;
            }

            button.dataset.themeSwitchBound = 'true';
            button.addEventListener('click', () => {
                window.__solitudeTheme?.toggleTheme();
            });
        };

        const bindThemeSwitches = () => {
            window.__solitudeTheme?.syncControls();
            document.querySelectorAll(TOGGLE_SELECTOR).forEach(bindToggle);
        };

        if (!window.__solitudeThemeSwitchReady) {
            window.__solitudeThemeSwitchReady = true;
            document.addEventListener('astro:page-load', bindThemeSwitches);
        }

        bindThemeSwitches();
    })();
</script>
