---
import NavbarBrand from './NavbarBrand.astro';
import NavbarUtility from './NavbarUtility.astro';
import type { Locale } from '@lib/i18n';

interface Props {
    logoUrl: string;
    siteTitle: string;
    siteSubTitle: string;
    homeUrl?: string;
    isFixed?: boolean;
    hideTitleOnMobile?: boolean;
    availableLocales?: readonly Locale[] | undefined;
    displayLocale?: Locale | undefined;
}

const {
    logoUrl,
    siteTitle,
    siteSubTitle,
    homeUrl = '/',
    isFixed = false,
    hideTitleOnMobile = false,
    availableLocales,
    displayLocale,
} = Astro.props;
const hasSecondary = Astro.slots.has('utility-secondary');
---

<nav
    class:list={[
        'smart-navbar z-50 h-[var(--site-navbar-height)] w-full translate-y-0 overflow-visible transition-transform duration-300 ease-in-out',
        isFixed ? 'fixed top-0 right-0 left-0' : 'relative',
    ]}
    data-site-navbar
    data-navbar-has-secondary={hasSecondary ? 'true' : 'false'}
    data-smart-navbar-fixed={isFixed ? 'true' : undefined}
    style="view-transition-name: site-navbar"
>
    <div
        class="site-navbar-shell overflow-visible"
        data-navbar-shell
        data-navbar-has-secondary={hasSecondary ? 'true' : 'false'}
    >
        <NavbarBrand
            logoImageUrl={logoUrl}
            siteTitle={siteTitle}
            siteSubTitle={siteSubTitle}
            homeUrl={homeUrl}
            hideTitleOnMobile={hideTitleOnMobile}
        />
        {
            hasSecondary && (
                <div class="site-navbar-secondary" data-navbar-secondary>
                    <slot name="utility-secondary" />
                </div>
            )
        }
        <NavbarUtility availableLocales={availableLocales} displayLocale={displayLocale}>
            <div slot="start"><slot name="utility-start" /></div>
            <div slot="end"><slot name="utility-end" /></div>
        </NavbarUtility>
    </div>
</nav>

<script>
    const navbarWindow = window as Window & {
        __solitudeSmartNavbar?: boolean;
    };

    if (!navbarWindow.__solitudeSmartNavbar) {
        navbarWindow.__solitudeSmartNavbar = true;

        const SCROLL_THRESHOLD = 100;
        const SCROLL_DELTA = 10;
        let lastScrollY = window.scrollY;
        let navbarFrame: number | null = null;

        const updateNavbar = () => {
            navbarFrame = null;
            const currentScrollY = window.scrollY;
            const delta = currentScrollY - lastScrollY;

            document
                .querySelectorAll<HTMLElement>('[data-smart-navbar-fixed="true"]')
                .forEach((navbar) => {
                    navbar.classList.toggle(
                        'smart-navbar-scrolled',
                        currentScrollY > SCROLL_THRESHOLD
                    );

                    const shouldHide = currentScrollY > SCROLL_THRESHOLD && delta > SCROLL_DELTA;
                    const shouldShow = delta < -SCROLL_DELTA || currentScrollY < SCROLL_THRESHOLD;

                    if (shouldHide) {
                        navbar.classList.add('-translate-y-full');
                        navbar.classList.remove('translate-y-0');
                    } else if (shouldShow) {
                        navbar.classList.remove('-translate-y-full');
                        navbar.classList.add('translate-y-0');
                    }
                });

            lastScrollY = currentScrollY;
        };

        const scheduleNavbarUpdate = () => {
            if (navbarFrame !== null) return;
            navbarFrame = window.requestAnimationFrame(updateNavbar);
        };

        const resetNavbar = () => {
            lastScrollY = window.scrollY;
            document
                .querySelectorAll<HTMLElement>('[data-smart-navbar-fixed="true"]')
                .forEach((navbar) => {
                    navbar.classList.remove('-translate-y-full');
                    navbar.classList.add('translate-y-0');
                    navbar.classList.toggle(
                        'smart-navbar-scrolled',
                        window.scrollY > SCROLL_THRESHOLD
                    );
                });
        };

        window.addEventListener('scroll', scheduleNavbarUpdate, { passive: true });
        document.addEventListener('astro:after-swap', resetNavbar);
        resetNavbar();
    }
</script>
