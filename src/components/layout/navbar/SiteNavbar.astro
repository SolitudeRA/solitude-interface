---
import SmartNavbar from './SmartNavbar.tsx';
import NavbarBrand from './NavbarBrand.astro';
import NavbarUtility from './NavbarUtility.astro';
import type { Locale } from '@lib/i18n';

interface Props {
    logoUrl: string;
    siteTitle: string;
    siteSubTitle: string;
    homeUrl?: string;
    isFixed?: boolean;
    hideTitleOnMobile?: boolean;
    availableLocales?: readonly Locale[] | undefined;
    displayLocale?: Locale | undefined;
}

const {
    logoUrl,
    siteTitle,
    siteSubTitle,
    homeUrl = '/',
    isFixed = false,
    hideTitleOnMobile = false,
    availableLocales,
    displayLocale,
} = Astro.props;
---

<SmartNavbar isFixed={isFixed} transitionName="site-navbar" client:idle>
    <NavbarBrand
        logoImageUrl={logoUrl}
        siteTitle={siteTitle}
        siteSubTitle={siteSubTitle}
        homeUrl={homeUrl}
        hideTitleOnMobile={hideTitleOnMobile}
    />
    <NavbarUtility availableLocales={availableLocales} displayLocale={displayLocale}>
        <div slot="start"><slot name="utility-start" /></div>
        <div slot="end"><slot name="utility-end" /></div>
    </NavbarUtility>
</SmartNavbar>
