---
import ThemeSwitch from './ThemeSwitch.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Locale } from '@lib/i18n';

interface Props {
    availableLocales?: readonly Locale[] | undefined;
    displayLocale?: Locale | undefined;
}

const { availableLocales, displayLocale } = Astro.props;
---

<div class="site-navbar-primary" data-navbar-primary>
    <div class="flex min-w-0 shrink-0 items-center">
        <slot name="start" />
    </div>
    <LanguageSwitcher availableLocales={availableLocales} displayLocale={displayLocale} />
    <ThemeSwitch />
    <div class="flex min-w-0 shrink-0 items-center">
        <slot name="end" />
    </div>
</div>
