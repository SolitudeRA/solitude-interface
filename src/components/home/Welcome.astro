---

<div
    class="welcome-title flex min-h-0 w-full flex-1 items-center justify-center px-5 py-6 text-center font-bold opacity-90"
>
    <span>Hi there, I'm SolitudeRA</span>
</div>

<style>
    .welcome-title {
        color: var(--text-site-title);
        font-size: clamp(1.8rem, 4.2vw, 3.5rem);
        line-height: 1.12;
        text-wrap: balance;
    }

    .welcome-title span {
        max-width: 20ch;
    }

    @media (max-width: 420px) {
        .welcome-title {
            font-size: clamp(1.7rem, 8.5vw, 2.1rem);
        }

        .welcome-title span {
            max-width: 17ch;
        }
    }

    /* 暗色主题 - 增强标题对比度，防止亮背景区域发灰 */
    :global(.dark) .welcome-title {
        text-shadow:
            0 2px 8px rgba(0, 0, 0, 0.45),
            0 4px 16px rgba(0, 0, 0, 0.25);
    }

    /* 亮色主题 - 轻微阴影增强可读性 */
    :global(.light) .welcome-title {
        text-shadow:
            0 1px 4px rgba(255, 255, 255, 0.6),
            0 2px 8px rgba(0, 0, 0, 0.08);
    }
</style>
