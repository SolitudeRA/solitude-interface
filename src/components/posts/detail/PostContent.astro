---
import PostHeader from './PostHeader.astro';
import ArticleReadingTools from './ArticleReadingTools.astro';
import ResponsiveImage from '@components/common/ResponsiveImage.astro';
import type { PostTag } from '@api/ghost/types';
import { sanitizeHtml, containsSuspiciousContent } from '@api/utils/sanitize';
import { highlightCodeBlocks } from '@api/utils/codeHighlight';
import { prepareArticleHtml, type CodeBlockLabels } from '@api/utils/articleHtml';
import { DEFAULT_LOCALE, type Locale } from '@lib/i18n';

interface Props {
    title: string;
    feature_image: URL | null;
    primary_tag?: PostTag | undefined;
    tags?: PostTag[] | undefined;
    published_at: string;
    html: string;
    backHref: string;
    locale?: Locale;
}

interface TocLabels {
    title: string;
    open: string;
    close: string;
    dialog: string;
    copyLink: string;
    linkCopied: string;
    backToTop: string;
}

const POST_DETAIL_COPY: Record<
    Locale,
    { toc: TocLabels; code: CodeBlockLabels; tableRegion: string }
> = {
    zh: {
        toc: {
            title: '目录',
            open: '打开目录',
            close: '关闭目录',
            dialog: '文章目录',
            copyLink: '复制当前链接',
            linkCopied: '已复制链接',
            backToTop: '回到顶部',
        },
        code: {
            wrap: '换行',
            scroll: '滚动',
            copy: '复制',
            copied: '已复制',
            failed: '失败',
            expand: '展开',
            collapse: '收起',
        },
        tableRegion: '可横向滚动的表格',
    },
    ja: {
        toc: {
            title: '目次',
            open: '目次を開く',
            close: '目次を閉じる',
            dialog: '記事の目次',
            copyLink: '現在のリンクをコピー',
            linkCopied: 'リンクをコピー済み',
            backToTop: '先頭へ戻る',
        },
        code: {
            wrap: '折返し',
            scroll: 'スクロール',
            copy: 'コピー',
            copied: 'コピー済み',
            failed: '失敗',
            expand: '展開',
            collapse: '閉じる',
        },
        tableRegion: '横スクロールできる表',
    },
    en: {
        toc: {
            title: 'Contents',
            open: 'Open contents',
            close: 'Close contents',
            dialog: 'Article contents',
            copyLink: 'Copy current link',
            linkCopied: 'Copied link',
            backToTop: 'Back to top',
        },
        code: {
            wrap: 'Wrap',
            scroll: 'Scroll',
            copy: 'Copy',
            copied: 'Copied',
            failed: 'Failed',
            expand: 'Show more',
            collapse: 'Show less',
        },
        tableRegion: 'Scrollable table',
    },
};

const {
    title,
    feature_image,
    primary_tag,
    tags,
    published_at,
    html,
    backHref,
    locale = DEFAULT_LOCALE,
} = Astro.props;
const featureImageUrl = feature_image?.toString() || '';
const copy = POST_DETAIL_COPY[locale];
const backLabel: Record<Locale, string> = {
    zh: '返回文章列表',
    ja: '記事一覧へ戻る',
    en: 'Back to articles',
};

// 安全：在服务端渲染时净化 HTML 内容
// 检测可疑内容用于日志监控（开发环境）
if (import.meta.env.DEV && containsSuspiciousContent(html)) {
    console.warn(`[PostContent] Suspicious content detected in post: ${title}`);
}

// 净化 HTML，移除潜在的 XSS 攻击向量
const sanitizedHtml = sanitizeHtml(html);

// 服务端代码高亮 - 在构建时处理所有代码块
const highlightedHtml = await highlightCodeBlocks(sanitizedHtml);
const articleHtml = prepareArticleHtml(highlightedHtml, copy.code, copy.tableRegion);
---

<div class="solitude-article-container grid grid-cols-1 xl:grid-cols-12">
    <ArticleReadingTools labels={copy.toc} codeLabels={copy.code} />

    <div class="solitude-article-rail hidden xl:col-span-2 xl:block"></div>

    <!-- 中间文章主体 - 移动端全宽，桌面端占7列 -->
    <div class="solitude-article-body col-span-1 pb-16 md:pb-24 lg:pb-32 xl:col-span-7">
        <div class="solitude-article-meta">
            <div
                class="solitude-article-meta-motion-media"
                transition:name="post-focus-media"
                aria-hidden="true"
            >
                {
                    featureImageUrl && (
                        <ResponsiveImage
                            src={featureImageUrl}
                            alt=""
                            widths={[480, 768, 1200, 1600, 2400]}
                            sizes="(min-width: 1280px) 58vw, 100vw"
                            quality={100}
                            priority
                            critical
                            progressive
                            className="solitude-article-meta-image"
                        />
                    )
                }
            </div>
            <div class="solitude-article-meta-motion-content" transition:name="post-focus-content">
                <div class="solitude-article-meta-motion-overlay" aria-hidden="true"></div>
                <a class="article-back-link" href={backHref} data-astro-prefetch="hover">
                    <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="m15 18-6-6 6-6"></path>
                    </svg>
                    <span>{backLabel[locale]}</span>
                </a>
                <PostHeader
                    title={title}
                    primary_tag={primary_tag}
                    tags={tags}
                    published_at={published_at}
                    locale={locale}
                />
            </div>
        </div>
        <div>
            <div class="solitude-article-content" set:html={articleHtml} />
        </div>
    </div>

    <!-- 右侧 TOC 区域 - 在移动端和平板隐藏 -->
    <div class="solitude-article-rail hidden xl:col-span-3 xl:flex">
        <div class="toc-wrapper w-full" data-article-toc hidden></div>
    </div>
</div>

<style>
    .solitude-article-meta {
        position: relative;
        border-radius: 0 0 24px 24px;
        margin-bottom: 2rem;
        isolation: isolate;
        overflow: hidden;
    }

    .solitude-article-meta-motion-media {
        position: absolute;
        inset: 0;
        z-index: -2;
        border-radius: inherit;
        background-color: var(--card-image-fallback-start);
    }

    .solitude-article-meta-motion-media :global(.solitude-article-meta-image) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .solitude-article-meta-motion-content {
        position: relative;
        z-index: 0;
        height: 100%;
        isolation: isolate;
    }

    .solitude-article-meta-motion-overlay {
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        background: linear-gradient(
            to bottom,
            var(--post-view-card-overlay-start) 0%,
            var(--post-view-card-overlay-mid) 50%,
            var(--post-view-card-overlay-end) 100%
        );
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        pointer-events: none;
    }

    .article-back-link {
        position: absolute !important;
        top: clamp(0.75rem, 2vw, 1.25rem);
        left: clamp(0.75rem, 2vw, 1.25rem);
        z-index: 3 !important;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 2.5rem;
        padding: 0.55rem 0.85rem;
        border: 1px solid color-mix(in srgb, var(--article-header-title) 24%, transparent);
        border-radius: 999px;
        color: var(--article-header-title);
        background: color-mix(in srgb, var(--background) 76%, transparent);
        box-shadow: 0 12px 34px rgba(0, 0, 0, 0.16);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        font-size: 0.78rem;
        font-weight: 700;
        text-decoration: none;
        transition:
            transform 180ms ease,
            background-color 180ms ease,
            border-color 180ms ease;
    }

    .article-back-link:hover {
        transform: translateX(-2px);
        border-color: color-mix(in srgb, var(--article-header-title) 42%, transparent);
        background: color-mix(in srgb, var(--background) 88%, transparent);
    }

    .article-back-link:focus-visible {
        outline: 2px solid var(--ring);
        outline-offset: 3px;
    }

    .article-back-link svg {
        width: 1rem;
        height: 1rem;
        flex: none;
    }

    @media (max-width: 767px) {
        .solitude-article-body {
            padding-bottom: calc(4rem + env(safe-area-inset-bottom));
        }

        .solitude-article-content {
            padding-top: clamp(10rem, 20svh, 12rem);
            padding-bottom: calc(3rem + env(safe-area-inset-bottom));
        }
    }
</style>
