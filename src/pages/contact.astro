---
const redirectTo = '/zh/contact';
---

<!doctype html>
<html lang="zh">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
        <link rel="canonical" href={new URL(redirectTo, Astro.site)} />
        <title>正在前往联系页面</title>
        <script is:inline>
            window.location.replace('/zh/contact');
        </script>
    </head>
    <body>
        <p>正在前往<a href={redirectTo}>联系页面</a>…</p>
    </body>
</html>
