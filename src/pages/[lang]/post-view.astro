---
import DockNav from '@components/layout/dock/DockNav.astro';
import DockSocial from '@components/layout/dock/DockSocial.astro';
import Dock from '@components/layout/dock/Dock.astro';
import PostViewContainer from '@components/posts/view/PostViewContainer.astro';
import PostArchiveView from '@components/posts/view/PostArchiveView';
import PostArchiveSearch from '@components/posts/view/PostArchiveSearch';
import PostArchiveNavbar from '@components/posts/view/PostArchiveNavbar';
import {
    parseArchiveParams,
    type ArchiveSeriesMetadataMap,
    type PostArchiveItem,
} from '@lib/postArchive';
import { extractFacets } from '@lib/postBrowse';
import { listAllPosts } from '@api/ghost/posts';
import { initializeSiteData } from '@api/ghost/settings';
import { getTagRegistry } from '@api/ghost/tagRegistry';
import BaseLayout from '@layouts/base/BaseLayout.astro';
import SiteNavbar from '@components/layout/navbar/SiteNavbar.astro';
import PageStage from '@components/layout/PageStage.astro';
import {
    LOCALES,
    type Locale,
    isLocale,
    LOCALE_HTML_LANG,
    generateAlternateLinks,
    filterPostsByLocale,
    getUIText,
} from '@lib/i18n';
import { env } from '@api/config/env';
import { getImage } from 'astro:assets';
import { getRemoteImageDimensions } from '@lib/remoteImageDimensions';
import { getTagDescription, getTagLabel } from '@lib/tagRegistry';

export async function getStaticPaths() {
    return LOCALES.map((lang) => ({
        params: { lang },
    }));
}

/** 画廊默认展示的精选/最近文章数；超出的进入列表视图 */
const FEATURED_COUNT = 16;

const { lang } = Astro.params;

if (!isLocale(lang)) {
    return Astro.redirect('/zh/post-view');
}

const locale = lang as Locale;
const htmlLang = LOCALE_HTML_LANG[locale];

const { siteTitle, siteDescription, logoUrl, coverImageUrl } = await initializeSiteData();

// 获取完整候选集后再按语言和 i18n key 去重
const allPosts = await listAllPosts();
// 按语言过滤：优先显示当前语言，如果没有则显示其他语言版本
const localizedPosts = filterPostsByLocale(allPosts, locale);
// 提取文章对象（已按发布日期排序）
const posts = localizedPosts.map((item) => item.post);
const tagRegistry = await getTagRegistry();
const seriesMetadata: ArchiveSeriesMetadataMap = {};

posts.forEach((post) => {
    const slug = post.post_series_slug?.trim();
    if (!slug || seriesMetadata[slug]) return;
    const registryEntry = tagRegistry[slug];
    const seriesTag = post.tags?.find((tag) => tag.slug === slug);
    const description =
        getTagDescription(slug, locale, tagRegistry) || seriesTag?.description?.trim() || '';

    seriesMetadata[slug] = {
        label: getTagLabel(slug, locale, seriesTag?.name, tagRegistry),
        ...(description ? { description } : {}),
        ...(registryEntry?.order !== undefined ? { order: registryEntry.order } : {}),
        ...(registryEntry?.color ? { color: registryEntry.color } : {}),
    };
});

// 画廊：精选/最近 N 篇（已按日期排序，slice 即最近）
const featuredPosts = posts.slice(0, FEATURED_COUNT);

// 列表：全量精简元数据（去 html、URL 转字符串），客户端筛选/分页
const listItems: PostArchiveItem[] = await Promise.all(
    posts.map(async (post) => {
        const featureImageUrl = post.feature_image?.toString() ?? null;
        const featureImageDimensions = featureImageUrl
            ? await getRemoteImageDimensions(featureImageUrl)
            : null;
        const featureImage =
            featureImageUrl && featureImageDimensions
                ? await getImage({
                      src: featureImageUrl,
                      width: featureImageDimensions.width,
                      height: featureImageDimensions.height,
                      widths: [320, 480, 640, 960],
                      format: 'webp',
                      quality: 74,
                  })
                : null;

        return {
            id: post.id,
            title: post.title,
            excerpt: post.excerpt,
            url: post.url.pathname,
            feature_image: featureImage?.src ?? featureImageUrl,
            ...(featureImage?.srcSet.attribute
                ? {
                      feature_image_srcset: featureImage.srcSet.attribute,
                      feature_image_sizes:
                          '(max-width: 639px) calc(100vw - 2rem), (max-width: 1279px) 48vw, 35vw',
                  }
                : {}),
            published_at: post.published_at,
            post_type: post.post_type,
            post_category: post.post_category,
            post_series: post.post_series,
            ...(post.post_series_slug ? { post_series_slug: post.post_series_slug } : {}),
            ...(post.post_series_label ? { post_series_label: post.post_series_label } : {}),
            ...(post.post_series_number ? { post_series_number: post.post_series_number } : {}),
            ...(post.post_type_label ? { post_type_label: post.post_type_label } : {}),
            ...(post.post_category_label ? { post_category_label: post.post_category_label } : {}),
        };
    })
);
const initialArchiveState = parseArchiveParams(Astro.url.searchParams);
const archiveFacets = extractFacets(listItems);
const initialPostViewMode = Astro.url.searchParams.get('view') === 'list' ? 'list' : 'gallery';
const isInitialList = initialPostViewMode === 'list';

const galleryLabel = getUIText('postView', 'galleryView', locale);
const listLabel = getUIText('postView', 'listView', locale);
const viewAllLabel = getUIText('postView', 'viewAll', locale).replace(
    '{total}',
    String(posts.length)
);

// 生成 hreflang 链接
const alternateLinks = generateAlternateLinks(env.site.url, '/post-view', LOCALES);
const canonicalUrl = `${env.site.url}/${locale}/post-view`;
---

<BaseLayout
    siteTitle={siteTitle}
    pageTitle={getUIText('nav', 'posts', locale)}
    coverImageUrl={coverImageUrl}
    lang={htmlLang}
    locale={locale}
    canonicalUrl={canonicalUrl}
    alternateLinks={alternateLinks}
    initialPostViewMode={initialPostViewMode}
>
    <SiteNavbar
        logoUrl={logoUrl}
        siteTitle={siteTitle}
        siteSubTitle={siteDescription}
        homeUrl={`/${locale}`}
        hideTitleOnMobile={true}
    >
        <div slot="utility-secondary" data-post-view-secondary class="w-max max-w-full">
            <PostArchiveNavbar
                client:load
                locale={locale}
                categories={archiveFacets.categories}
                initialLayout={initialArchiveState.layout}
                initialCategory={initialArchiveState.filters.category}
            />
        </div>
        <div slot="utility-start" class="contents">
            <div
                class="post-view-toggle site-top-control site-top-control-group"
                role="tablist"
                aria-label={`${galleryLabel} / ${listLabel}`}
            >
                <button
                    type="button"
                    role="tab"
                    id="post-view-tab-gallery"
                    data-view-toggle="gallery"
                    data-active={isInitialList ? 'false' : 'true'}
                    aria-selected={isInitialList ? 'false' : 'true'}
                    aria-controls="post-view-panel-gallery"
                    tabindex={isInitialList ? '-1' : '0'}
                    class="site-top-control-item"
                >
                    {galleryLabel}
                </button>
                <button
                    type="button"
                    role="tab"
                    id="post-view-tab-list"
                    data-view-toggle="list"
                    data-active={isInitialList ? 'true' : 'false'}
                    aria-selected={isInitialList ? 'true' : 'false'}
                    aria-controls="post-view-panel-list"
                    tabindex={isInitialList ? '0' : '-1'}
                    class="site-top-control-item"
                >
                    {listLabel}
                </button>
            </div>
        </div>
        <div slot="utility-end" class="contents">
            <PostArchiveSearch
                client:load
                locale={locale}
                initialQuery={initialArchiveState.filters.query}
            />
        </div>
    </SiteNavbar>

    <PageStage variant="posts">
        {/* 精选视图（默认） */}
        <div
            id="post-view-panel-gallery"
            role="tabpanel"
            aria-labelledby="post-view-tab-gallery"
            data-view-section="gallery"
            hidden={isInitialList}
        >
            <PostViewContainer posts={featuredPosts} locale={locale} viewAllLabel={viewAllLabel} />
        </div>

        {/* 全部视图 —— 首屏 SSR、默认隐藏，由脚本按 ?view= 显隐 */}
        <div
            id="post-view-panel-list"
            role="tabpanel"
            aria-labelledby="post-view-tab-list"
            data-view-section="list"
            hidden={!isInitialList}
        >
            <PostArchiveView
                client:visible
                posts={listItems}
                locale={locale}
                seriesMetadata={seriesMetadata}
                initialFilters={initialArchiveState.filters}
                initialLayout={initialArchiveState.layout}
                initialPagination={initialArchiveState.pagination}
            />
        </div>
    </PageStage>

    <Dock isFixed={true}>
        <div id="post-archive-pagination-host" class="flex min-w-0 items-center justify-self-start">
        </div>
        <DockNav lang={locale} />
        <DockSocial lang={locale} />
    </Dock>

    <script>
        import { initPostViewModeController } from '@lib/navigation/postViewModeController';
        import { initPostViewScrollFallback } from '@components/posts/view/postViewScrollFallback';

        initPostViewModeController();
        initPostViewScrollFallback();
    </script>
</BaseLayout>

<style>
    :global(html:has([data-post-view-secondary])) {
        --site-navbar-height: clamp(6.5rem, 15svh, 7.1rem);
    }

    /* 画廊视图：锁定页面滚动，让滚轮只作用于横向容器（默认态） */
    :global(html),
    :global(body) {
        overflow: hidden;
        height: 100vh;
    }

    /* 全部视图：同样锁住页面纵向滚动，由归档面板承接各自的滚动。 */
    :global(html[data-post-view-mode='list']),
    :global(html[data-post-view-mode='list'] body) {
        overflow: hidden;
        height: 100vh;
    }

    /* 精选与全部共用同一主内容视口，避免切换时容器高度跳动。 */
    :global(.post-view-main-viewport) {
        --post-view-available-height: calc(
            100svh - var(--site-navbar-height) - var(--site-dock-height)
        );
        --post-view-content-height: clamp(
            500px,
            min(72svh, var(--post-view-available-height)),
            780px
        );

        height: var(--post-view-available-height);
        min-height: 0;
    }

    @media (pointer: coarse) {
        :global(.post-view-main-viewport) {
            --post-view-content-height: clamp(
                430px,
                min(68svh, var(--post-view-available-height)),
                560px
            );
        }
    }

    @media (min-width: 96rem) {
        :global(html:has([data-post-view-secondary])) {
            --site-navbar-height: clamp(5rem, 11svh, 7rem);
        }
    }

    @media (pointer: fine) and (max-height: 780px) {
        :global(.post-view-main-viewport) {
            --post-view-content-height: clamp(420px, var(--post-view-available-height), 560px);
        }
    }

    @media (pointer: fine) and (min-width: 1920px) {
        :global(.post-view-main-viewport) {
            --post-view-content-height: clamp(
                620px,
                min(72svh, var(--post-view-available-height)),
                820px
            );
        }
    }

    @media (pointer: fine) and (min-width: 2560px) and (min-height: 1600px) {
        :global(.post-view-main-viewport) {
            --post-view-content-height: clamp(
                760px,
                min(54svh, var(--post-view-available-height)),
                1000px
            );
        }
    }

    /* 隐藏的视图段彻底移除（防止 flex/grid 类覆盖 [hidden]） */
    :global([data-view-section][hidden]) {
        display: none !important;
    }

    /* Reserve the pager's final footprint before “全部” becomes visible, so the deferred island
       can mount its portal without nudging the Dock. */
    :global(#post-archive-pagination-host) {
        min-height: 2rem;
    }

    :global(html[data-post-view-mode='list'] #post-archive-pagination-host) {
        min-width: 7.5rem;
    }

    @media (min-width: 640px) {
        :global(#post-archive-pagination-host) {
            min-height: 2.5rem;
        }

        :global(html[data-post-view-mode='list'] #post-archive-pagination-host) {
            min-width: 9.25rem;
        }
    }
</style>
