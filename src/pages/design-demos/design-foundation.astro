    html.light .demo-ambient {
        background:
            radial-gradient(circle at 16% 12%, oklch(0.82 0.1 225 / 0.55), transparent 32%),
            radial-gradient(circle at 82% 72%, oklch(0.83 0.1 305 / 0.42), transparent 34%),
            linear-gradient(
                145deg,
                oklch(0.965 0.012 245),
                oklch(0.91 0.025 254) 60%,
                oklch(0.965 0.012 270)
            );
