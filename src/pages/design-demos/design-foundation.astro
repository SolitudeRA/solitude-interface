    .demo-orbit {
        position: absolute;
        width: 32rem;
        aspect-ratio: 1;
        border: 1px solid oklch(0.88 0.08 235 / 0.12);
        border-radius: 50%;
        box-shadow: 0 0 120px oklch(0.62 0.15 260 / 0.08) inset;
    }

    .demo-orbit::before,
    .demo-orbit::after {
        content: '';
        position: absolute;
        inset: 14%;
        border: 1px solid oklch(0.88 0.08 300 / 0.1);
        border-radius: inherit;
        transform: rotate(24deg) scaleY(0.36);
    }

    .demo-orbit::after {
        inset: 27%;
        transform: rotate(-42deg) scaleY(0.5);
    }

    .demo-orbit-a {
        top: -13rem;
        right: -8rem;
    }

    .demo-orbit-b {
        bottom: -18rem;
        left: -10rem;
        width: 38rem;
    }

    .demo-grain {
