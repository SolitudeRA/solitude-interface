    .demo-ambient {
        position: fixed;
        inset: 0;
        z-index: -2;
        overflow: hidden;
        background:
            radial-gradient(circle at 16% 12%, oklch(0.67 0.16 236 / 0.28), transparent 30%),
            radial-gradient(circle at 82% 72%, oklch(0.62 0.16 307 / 0.22), transparent 32%),
            linear-gradient(
