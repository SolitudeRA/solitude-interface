        inset: 0;
        background:
            radial-gradient(ellipse at center, transparent 35%, oklch(0 0 0 / 0.38)),
            linear-gradient(to bottom, transparent 10%, oklch(0 0 0 / 0.28));
        pointer-events: none;
    }

    html.light .demo-ambient::after {
        background:
            radial-gradient(ellipse at center, transparent 35%, oklch(0.4 0.03 250 / 0.14)),
            linear-gradient(to bottom, transparent 10%, oklch(0.45 0.03 250 / 0.12));
