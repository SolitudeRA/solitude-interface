---
import '@styles/index.css';
import SiteDock from '@components/layout/dock/SiteDock.astro';
---

<!doctype html>
<html lang="zh-CN" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="dark light" />
        <title>Protogalaxy · Design Foundation Demo</title>
    </head>
    <body>
        <div class="demo-ambient" aria-hidden="true">
            <span class="demo-orbit demo-orbit-a"></span>
            <span class="demo-orbit demo-orbit-b"></span>
            <span class="demo-grain"></span>
        </div>

        <main
            class="demo-root"
            data-demo-root
            data-demo-size="auto"
            data-demo-view="archive"
            data-demo-layout="editorial"
            data-demo-material="quiet"
        >
            <header class="demo-toolbar">
                <div class="demo-heading">
                    <p>DESIGN FOUNDATION · INTERACTIVE PREVIEW</p>
                    <h1>让导航先稳定，内容自然安静下来。</h1>
                </div>

                <div class="demo-toolbar-controls">
                    <div class="demo-toolbar-group" role="group" aria-label="预览宽度">
                        <button type="button" data-size-option="auto" aria-pressed="true"
                            >自动</button
                        >
                        <button type="button" data-size-option="wide" aria-pressed="false"
                            >宽屏</button
                        >
                        <button type="button" data-size-option="compact" aria-pressed="false"
                            >紧凑</button
                        >
                        <button type="button" data-size-option="mobile" aria-pressed="false"
                            >移动</button
                        >
                    </div>

                    <div class="demo-toolbar-group" role="group" aria-label="材质密度">
                        <button type="button" data-material-option="quiet" aria-pressed="true"
                            >克制材质</button
                        >
                        <button type="button" data-material-option="layered" aria-pressed="false"
                            >高玻璃密度</button
                        >
                    </div>
                </div>
            </header>

            <section class="demo-frame" aria-label="网站导航设计预览">
                <div class="demo-viewport" data-demo-viewport>
                    <div class="site-preview">
                        <header class="preview-navbar" data-preview-navbar>
                            <a
                                class="preview-brand"
                                href="#preview-content"
                                aria-label="Protogalaxy 首页"
                            >
                                <span class="preview-logo" aria-hidden="true">
                                    <span></span>
                                </span>
                                <span class="preview-brand-copy">
                                    <strong>Protogalaxy</strong>
                                    <small>In solitude, Where we are least alone</small>
                                </span>
                            </a>

                            <div
                                class="preview-secondary"
                                data-preview-secondary
                                aria-hidden="false"
                                aria-label="全部文章视图选项"
                            >
                                <div
                                    class="preview-control preview-layout-tabs"
                                    role="group"
                                    aria-label="归档布局"
                                >
                                    <button
                                        id="layout-option-editorial"
                                        type="button"
                                        data-layout-option="editorial"
                                        aria-pressed="true"
                                        aria-label="编辑目录"
                                    >
                                        <svg aria-hidden="true" viewBox="0 0 24 24">
                                            <path d="M5 5h14M5 12h14M5 19h14"></path>
                                        </svg>
                                        <span>编辑目录</span>
                                    </button>
                                    <button
                                        id="layout-option-series"
                                        type="button"
                                        data-layout-option="series"
                                        aria-pressed="false"
                                        aria-label="系列书库"
                                    >
                                        <svg aria-hidden="true" viewBox="0 0 24 24">
                                            <path
                                                d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5ZM20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5Z"
                                            ></path>
                                        </svg>
                                        <span>系列书库</span>
                                    </button>
                                    <button
                                        id="layout-option-years"
                                        type="button"
                                        data-layout-option="years"
                                        aria-pressed="false"
                                        aria-label="年代分栏"
                                    >
                                        <svg aria-hidden="true" viewBox="0 0 24 24">
                                            <path
                                                d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z"
                                            ></path>
                                        </svg>
                                        <span>年代分栏</span>
                                    </button>
                                </div>

                                <div
                                    class="preview-control preview-category-tabs"
                                    aria-label="文章分类"
                                >
                                    <button type="button" data-category-option aria-pressed="true"
                                        >全部</button
                                    >
                                    <button type="button" data-category-option aria-pressed="false"
                                        >技术</button
                                    >
                                    <button type="button" data-category-option aria-pressed="false"
                                        >随笔</button
                                    >
                                </div>

                                <button
                                    type="button"
                                    class="preview-control preview-category-menu"
                                    aria-label="选择文章分类"
                                >
                                    全部分类
                                    <svg aria-hidden="true" viewBox="0 0 24 24">
                                        <path d="m7 10 5 5 5-5"></path>
                                    </svg>
                                </button>
                            </div>

                            <div class="preview-primary">
                                <div
                                    class="preview-control preview-view-tabs"
                                    role="tablist"
                                    aria-label="文章视图"
                                >
                                    <button
                                        id="view-option-featured"
                                        type="button"
                                        role="tab"
                                        data-view-option="featured"
                                        aria-controls="featured-preview-panel"
                                        aria-selected="false"
                                        tabindex="-1">精选</button
                                    >
                                    <button
                                        id="view-option-archive"
                                        type="button"
                                        role="tab"
                                        data-view-option="archive"
                                        aria-controls="archive-preview-panel"
                                        aria-selected="true"
                                        tabindex="0">全部</button
                                    >
                                </div>

                                <button
                                    class="preview-control preview-language"
                                    type="button"
                                    aria-label="切换语言"
                                >
                                    <svg aria-hidden="true" viewBox="0 0 24 24">
                                        <circle cx="12" cy="12" r="9"></circle>
                                        <path
                                            d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"
                                        ></path>
                                    </svg>
                                    <span>中文</span>
                                    <svg
                                        class="preview-chevron"
                                        aria-hidden="true"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="m7 10 5 5 5-5"></path>
                                    </svg>
                                </button>

                                <button
                                    class="preview-control preview-icon-control"
                                    type="button"
                                    data-theme-toggle
                                    aria-label="切换明暗主题"
                                >
                                    <svg
                                        class="preview-theme-moon"
                                        aria-hidden="true"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M20.4 15.3A9 9 0 0 1 8.7 3.6 9 9 0 1 0 20.4 15.3Z"
                                        ></path>
                                    </svg>
                                    <svg
                                        class="preview-theme-sun"
                                        aria-hidden="true"
                                        viewBox="0 0 24 24"
                                    >
                                        <circle cx="12" cy="12" r="4"></circle>
                                        <path
                                            d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
                                        ></path>
                                    </svg>
                                </button>

                                <button
                                    class="preview-control preview-icon-control"
                                    type="button"
                                    data-search-toggle
                                    aria-label="展开搜索"
                                    aria-expanded="false"
                                    aria-controls="preview-search"
                                >
                                    <svg aria-hidden="true" viewBox="0 0 24 24">
                                        <circle cx="11" cy="11" r="7"></circle>
                                        <path d="m20 20-4-4"></path>
                                    </svg>
                                </button>
                            </div>

                            <form
                                class="preview-search"
                                id="preview-search"
                                data-preview-search
                                hidden
                            >
                                <svg aria-hidden="true" viewBox="0 0 24 24">
                                    <circle cx="11" cy="11" r="7"></circle>
                                    <path d="m20 20-4-4"></path>
                                </svg>
                                <input
                                    type="search"
                                    name="preview-search"
                                    placeholder="搜索标题、摘要或系列…"
                                    autocomplete="off"
                                />
                                <kbd>Esc</kbd>
                            </form>
                        </header>

                        <div class="preview-content" id="preview-content">
                            <section class="preview-intro">
                                <div>
                                    <p class="preview-kicker" data-preview-kicker>
                                        ALL POSTS · EDITORIAL INDEX
                                    </p>
                                    <h2 data-preview-title>
                                        内容控件属于导航，阅读空间只保留内容。
                                    </h2>
                                </div>
                                <p data-preview-description>
                                    宽度充足时所有控件自然同行；空间不足时，归档控件整组换到第二行并保持右对齐。
                                </p>
                            </section>

                            <section
                                class="archive-preview"
                                id="archive-preview-panel"
                                data-archive-preview
                                role="tabpanel"
                                aria-labelledby="view-option-archive"
                            >
                                <article
                                    class="archive-panel archive-panel-index"
                                    data-layout-panel="editorial"
                                >
                                    <header>
                                        <span>EDITORIAL INDEX</span>
                                        <strong>编辑目录</strong>
                                        <small>24 stories</small>
                                    </header>
                                    <div class="archive-list">
                                        <a href="#demo-story-1" class="is-active">
                                            <span>01</span>
                                            <strong>从服务选型到稳定运行</strong>
                                            <time>07.16</time>
                                        </a>
                                        <a href="#demo-story-2">
                                            <span>02</span>
                                            <strong>让空间记住阅读位置</strong>
                                            <time>07.12</time>
                                        </a>
                                        <a href="#demo-story-3">
                                            <span>03</span>
                                            <strong>Reboot：一次安静的重构</strong>
                                            <time>07.08</time>
                                        </a>
                                    </div>
                                </article>

                                <div class="archive-panel archive-panel-preview">
                                    <div class="archive-cover" aria-hidden="true">
                                        <span class="archive-cover-orbit"></span>
                                    </div>
                                    <div class="archive-copy">
                                        <div class="archive-chips">
                                            <span>文章</span>
                                            <span>技术</span>
                                        </div>
                                        <h3 data-archive-title>从服务选型到稳定运行</h3>
                                        <p data-archive-copy>
                                            更少的玻璃叠层，让图片、标题和导航重新拥有清晰的前后关系。
                                        </p>
                                        <time>2026-07-16</time>
                                    </div>
                                </div>

                                <article class="archive-panel archive-panel-rail">
                                    <header>
                                        <span data-rail-label>READING PATH</span>
                                        <strong data-rail-title>最近更新</strong>
                                    </header>
                                    <ol data-rail-list>
                                        <li><span>01</span><strong>稳定的外壳</strong></li>
                                        <li><span>02</span><strong>安静的内容层</strong></li>
                                        <li><span>03</span><strong>明确的焦点</strong></li>
                                    </ol>
                                </article>
                            </section>

                            <section
                                class="featured-preview"
                                id="featured-preview-panel"
                                data-featured-preview
                                role="tabpanel"
                                aria-labelledby="view-option-featured"
                                hidden
                            >
                                <a class="featured-card featured-card-main" href="#featured-main">
                                    <div class="featured-art featured-art-a" aria-hidden="true">
                                    </div>
                                    <span class="featured-chip">精选 · 技术</span>
                                    <div>
                                        <h3>构建一个稳定、连续的阅读空间</h3>
                                        <p>保留沉浸感，但让控件退出内容舞台。</p>
                                    </div>
                                </a>
                                <a class="featured-card featured-card-side" href="#featured-side">
                                    <div class="featured-art featured-art-b" aria-hidden="true">
                                    </div>
                                    <span class="featured-chip">系列 · Notes</span>
                                    <div>
                                        <h3>设计不是增加，而是排序</h3>
                                        <p>用规则驱动非对称，而不是随机变化。</p>
                                    </div>
                                </a>
                                <a class="featured-card featured-card-small" href="#featured-small">
                                    <div class="featured-art featured-art-c" aria-hidden="true">
                                    </div>
                                    <span class="featured-chip">随笔</span>
                                    <div>
                                        <h3>在背景与文字之间留出呼吸</h3>
                                    </div>
                                </a>
                            </section>
                        </div>

                        <footer class="preview-material-key" aria-label="材质层级说明">
                            <span><i class="key-environment"></i>环境层</span>
                            <span><i class="key-content"></i>内容层</span>
                            <span><i class="key-floating"></i>浮动玻璃层</span>
                        </footer>
                    </div>
                </div>
            </section>

            <p class="demo-caption" role="status" aria-live="polite" data-demo-caption>
                自动宽度 · 全部文章 · 编辑目录 · 克制材质
            </p>
        </main>

        <SiteDock isFixed={true} layout="home" lang="zh" />

        <script is:inline>
            (() => {
                const root = document.querySelector('[data-demo-root]');
                if (!root) return;

                const caption = root.querySelector('[data-demo-caption]');
                const search = root.querySelector('[data-preview-search]');
                const searchToggle = root.querySelector('[data-search-toggle]');
                const featuredPreview = root.querySelector('[data-featured-preview]');
                const archivePreview = root.querySelector('[data-archive-preview]');
                const secondary = root.querySelector('[data-preview-secondary]');
                const kicker = root.querySelector('[data-preview-kicker]');
                const title = root.querySelector('[data-preview-title]');
                const description = root.querySelector('[data-preview-description]');

                const labels = {
                    size: {
                        auto: '自动宽度',
                        wide: '宽屏单行',
                        compact: '紧凑双行',
                        mobile: '移动布局',
                    },
                    view: { featured: '精选文章', archive: '全部文章' },
                    layout: {
                        editorial: '编辑目录',
                        series: '系列书库',
                        years: '年代分栏',
                    },
                    material: { quiet: '克制材质', layered: '高玻璃密度' },
                };

                const updateCaption = () => {
                    caption.textContent = [
                        labels.size[root.dataset.demoSize],
                        labels.view[root.dataset.demoView],
                        root.dataset.demoView === 'archive'
                            ? labels.layout[root.dataset.demoLayout]
                            : null,
                        labels.material[root.dataset.demoMaterial],
                    ]
                        .filter(Boolean)
                        .join(' · ');
                };

                const selectOption = (selector, attribute, value) => {
                    root.querySelectorAll(selector).forEach((button) => {
                        const active = button.dataset[attribute] === value;
                        if (button.getAttribute('role') === 'tab') {
                            button.setAttribute('aria-selected', String(active));
                            button.removeAttribute('aria-pressed');
                            button.tabIndex = active ? 0 : -1;
                        } else {
                            button.setAttribute('aria-pressed', String(active));
                        }
                    });
                };

                root.addEventListener('click', (event) => {
                    const sizeButton = event.target.closest('[data-size-option]');
                    if (sizeButton) {
                        root.dataset.demoSize = sizeButton.dataset.sizeOption;
                        selectOption(
                            '[data-size-option]',
                            'sizeOption',
                            sizeButton.dataset.sizeOption
                        );
                        updateCaption();
                        return;
                    }

                    const materialButton = event.target.closest('[data-material-option]');
                    if (materialButton) {
                        root.dataset.demoMaterial = materialButton.dataset.materialOption;
                        selectOption(
                            '[data-material-option]',
                            'materialOption',
                            materialButton.dataset.materialOption
                        );
                        updateCaption();
                        return;
                    }

                    const viewButton = event.target.closest('[data-view-option]');
                    if (viewButton) {
                        const view = viewButton.dataset.viewOption;
                        root.dataset.demoView = view;
                        selectOption('[data-view-option]', 'viewOption', view);
                        const featured = view === 'featured';
                        featuredPreview.hidden = !featured;
                        archivePreview.hidden = featured;
                        secondary.setAttribute('aria-hidden', String(featured));
                        kicker.textContent = featured
                            ? 'FEATURED STORIES · IMMERSIVE GALLERY'
                            : `ALL POSTS · ${labels.layout[root.dataset.demoLayout].toUpperCase()}`;
                        title.textContent = featured
                            ? '精选保留沉浸感，导航保持稳定。'
                            : '内容控件属于导航，阅读空间只保留内容。';
                        description.textContent = featured
                            ? '切换视图时只替换内容舞台，品牌、主题、搜索和底部 Dock 都保持连续。'
                            : '宽度充足时所有控件自然同行；空间不足时，归档控件整组换到第二行并保持右对齐。';
                        updateCaption();
                        return;
                    }

                    const layoutButton = event.target.closest('[data-layout-option]');
                    if (layoutButton) {
                        const layout = layoutButton.dataset.layoutOption;
                        root.dataset.demoLayout = layout;
                        selectOption('[data-layout-option]', 'layoutOption', layout);
                        const layoutCopy = {
                            editorial: {
                                kicker: 'ALL POSTS · EDITORIAL INDEX',
                                rail: 'READING PATH',
                                title: '最近更新',
                                article: '从服务选型到稳定运行',
                                copy: '更少的玻璃叠层，让图片、标题和导航重新拥有清晰的前后关系。',
                            },
                            series: {
                                kicker: 'ALL POSTS · SERIES LIBRARY',
                                rail: 'COLLECTION 03',
                                title: 'Home Server',
                                article: '把连续文章整理成一座书架',
                                copy: '系列通过封面与编号形成路径，悬停预览留在内容区，不再遮挡相邻书目。',
                            },
                            years: {
                                kicker: 'ALL POSTS · YEAR COLUMNS',
                                rail: 'ARCHIVE 2026',
                                title: '今年的轨迹',
                                article: '用年份建立时间上的阅读坐标',
                                copy: '分栏强调时间关系，同时共用同一套卡片遮罩、标签和标题层级。',
                            },
                        }[layout];
                        kicker.textContent = layoutCopy.kicker;
                        root.querySelector('[data-rail-label]').textContent = layoutCopy.rail;
                        root.querySelector('[data-rail-title]').textContent = layoutCopy.title;
                        root.querySelector('[data-archive-title]').textContent = layoutCopy.article;
                        root.querySelector('[data-archive-copy]').textContent = layoutCopy.copy;
                        updateCaption();
                        return;
                    }

                    if (event.target.closest('[data-category-option]')) {
                        const button = event.target.closest('[data-category-option]');
                        root.querySelectorAll('[data-category-option]').forEach((option) => {
                            option.setAttribute('aria-pressed', String(option === button));
                        });
                        return;
                    }

                    if (event.target.closest('[data-search-toggle]')) {
                        const willOpen = search.hidden;
                        search.hidden = !willOpen;
                        searchToggle.setAttribute('aria-expanded', String(willOpen));
                        if (willOpen) {
                            requestAnimationFrame(() => search.querySelector('input')?.focus());
                        }
                        return;
                    }

                    if (event.target.closest('[data-theme-toggle]')) {
                        const html = document.documentElement;
                        const dark = html.classList.toggle('dark');
                        html.classList.toggle('light', !dark);
                    }
                });

                search.addEventListener('submit', (event) => {
                    event.preventDefault();
                    const value = search.querySelector('input')?.value.trim();
                    caption.textContent = value
                        ? `搜索预览 · ${value}`
                        : '请输入标题、摘要或系列名称。';
                });

                root.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape' && !search.hidden) {
                        search.hidden = true;
                        searchToggle.setAttribute('aria-expanded', 'false');
                        searchToggle.focus();
                        return;
                    }

                    const current = event.target.closest('[role="tab"]');
                    if (
                        !current ||
                        !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)
                    ) {
                        return;
                    }

                    const tabs = Array.from(current.parentElement.querySelectorAll('[role="tab"]'));
                    let nextIndex = tabs.indexOf(current);
                    if (event.key === 'Home') nextIndex = 0;
                    if (event.key === 'End') nextIndex = tabs.length - 1;
                    if (event.key === 'ArrowLeft')
                        nextIndex = (nextIndex - 1 + tabs.length) % tabs.length;
                    if (event.key === 'ArrowRight') nextIndex = (nextIndex + 1) % tabs.length;
                    event.preventDefault();
                    tabs[nextIndex].focus();
                    tabs[nextIndex].click();
                });

                document.addEventListener(
                    'click',
                    (event) => {
                        const dockLink = event.target.closest('[data-dock-root] a[href]');
                        if (!dockLink) return;
                        event.preventDefault();
                        caption.textContent =
                            'Demo 中保留现有 Dock；正式落地时继续使用原导航目标。';
                    },
                    true
                );

                document.addEventListener('click', (event) => {
                    if (
                        search.hidden ||
                        search.contains(event.target) ||
                        searchToggle.contains(event.target)
                    ) {
                        return;
                    }

                    search.hidden = true;
                    searchToggle.setAttribute('aria-expanded', 'false');
                });

                updateCaption();
            })();
        </script>
    </body>
</html>

<style is:global>
    :root {
        color-scheme: dark;
        --demo-control-height: 2.5rem;
        --demo-control-radius: 999px;
        --demo-control-gap: 0.38rem;
        --demo-control-bg: color-mix(in oklch, var(--background) 76%, transparent);
        --demo-control-bg-hover: color-mix(in oklch, var(--foreground) 9%, var(--demo-control-bg));
        --demo-control-border: color-mix(in oklch, var(--border) 76%, transparent);
        --demo-surface-content: color-mix(in oklch, var(--background) 78%, transparent);
        --demo-surface-content-strong: color-mix(in oklch, var(--background) 90%, transparent);
        --demo-surface-glass: color-mix(in oklch, var(--background) 64%, transparent);
        --demo-shadow-low: 0 12px 34px oklch(0 0 0 / 0.12);
        --demo-shadow-float: 0 22px 64px oklch(0 0 0 / 0.26);
        --demo-motion-micro: 150ms;
        --demo-motion-state: 210ms;
        --demo-motion-stage: 300ms;
        --demo-ease: cubic-bezier(0.22, 1, 0.36, 1);
        font-family:
            'Noto Sans SC Variable',
            'Noto Sans Variable',
            system-ui,
            -apple-system,
            sans-serif;
    }

    html.light {
        color-scheme: light;
    }

    html,
    body {
        min-height: 100%;
    }

    body {
        margin: 0;
        min-height: 100svh;
        color: var(--foreground);
