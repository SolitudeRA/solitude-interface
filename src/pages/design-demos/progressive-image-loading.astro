---
import { Image, getImage } from 'astro:assets';
import '@styles/index.css';

const sourceImage = 'https://ghost.solitudera.com/content/images/2026/01/91719981_p0.jpg';
const lowStage = await getImage({
    src: sourceImage,
    inferSize: true,
    width: 160,
    format: 'webp',
    quality: 45,
});
const mediumStage = await getImage({
    src: sourceImage,
    inferSize: true,
    width: 480,
    format: 'webp',
    quality: 68,
});

const responsiveWidths = [320, 480, 640, 960, 1280];
const responsiveSizes =
    '(max-width: 620px) calc(100vw - 2rem), (max-width: 1100px) calc((100vw - 5rem) / 2), (max-width: 1500px) calc((100vw - 12rem) / 2), 640px';
---

<!doctype html>
<html lang="zh-CN" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="dark" />
        <title>Protogalaxy · Resolution Ladder Demo</title>
    </head>
    <body>
        <main
            class="demo-shell"
            data-progressive-demo
            data-mode="home"
            data-delay="1200"
            style={`--demo-placeholder: url("${lowStage.src}");`}
        >
            <header class="demo-header">
                <div>
                    <p class="demo-kicker">IMAGE PIPELINE · RESOLUTION LADDER</p>
                    <h1>让清晰度逐级到位，<span>不靠模糊掩盖等待。</span></h1>
                    <p class="demo-intro">
                        左侧模拟当前直接加载；右侧依次显示 160w、480w
                        与自适应高清图。每一段都保留真实细节，只在图片完成 decode
                        后做很短的透明度衔接。
                    </p>
                </div>

                <div class="demo-controls" aria-label="Demo controls">
                    <div class="demo-control-group" role="group" aria-label="卡片形态">
                        <button type="button" data-mode-option="home" data-active="true"
                            >首页卡片</button
                        >
                        <button type="button" data-mode-option="posts" data-active="false"
                            >Posts 卡片</button
                        >
                    </div>
                    <div class="demo-control-group" role="group" aria-label="模拟延迟">
                        <button type="button" data-delay-option="700" data-active="false"
                            >0.7s</button
                        >
                        <button type="button" data-delay-option="1200" data-active="true"
                            >1.2s</button
                        >
                        <button type="button" data-delay-option="2200" data-active="false"
                            >2.2s</button
                        >
                    </div>
                    <button class="demo-replay" type="button" data-replay>
                        <svg aria-hidden="true" viewBox="0 0 24 24">
                            <path d="M20 11a8 8 0 1 0-2.35 5.65M20 4v7h-7"></path>
                        </svg>
                        重播加载
                    </button>
                </div>
            </header>

            <section class="demo-comparison" aria-label="渐进式图片加载对比">
                <article class="demo-column demo-current">
                    <div class="demo-label-row">
                        <div>
                            <span class="demo-index">01</span>
                            <h2>当前方案</h2>
                        </div>
                        <span class="demo-quality">WebP · Q74</span>
                    </div>

                    <div class="demo-card">
                        <div class="demo-image-stage">
                            <Image
                                src={sourceImage}
                                inferSize
                                widths={responsiveWidths}
                                sizes={responsiveSizes}
                                format="webp"
                                quality={74}
                                alt=""
                                class="demo-final-image"
                                loading="eager"
                                decoding="async"
                            />
                        </div>
                        <div class="demo-media-overlay"></div>
                        <div class="demo-title-gradient"></div>
                        <div class="demo-tags">
                            <span>文章</span>
                            <span>技术</span>
                        </div>
                        <div class="demo-card-copy">
                            <h3>构建智能家居平台</h3>
                            <p>
                                引言 在上一篇 Homeserver Complete Build Guide
                                中，我们介绍了家庭服务器的基础环境。
                            </p>
                            <time>2025-02-12</time>
                        </div>
                        <div class="demo-loading-state" data-current-state>等待高清图</div>
                    </div>

                    <p class="demo-note">
                        响应完成前只有底色；随后图片直接出现，最终细节仍受 Q74 限制。
                    </p>
                </article>

                <div class="demo-divider" aria-hidden="true">
                    <span>VS</span>
                </div>

                <article class="demo-column demo-progressive">
                    <div class="demo-label-row">
                        <div>
                            <span class="demo-index">02</span>
                            <h2>推荐方案</h2>
                        </div>
                        <span class="demo-quality is-recommended">160w → 480w → Q100</span>
                    </div>

                    <div class="demo-card">
                        <div class="demo-image-stage">
                            <img
                                src={lowStage.src}
                                alt=""
                                width="160"
                                height="112"
                                class="demo-stage-image demo-stage-low"
                                aria-hidden="true"
                            />
                            <img
                                src={mediumStage.src}
                                alt=""
                                width="480"
                                height="336"
                                class="demo-stage-image demo-stage-medium"
                                aria-hidden="true"
                                data-progressive-medium
                            />
                            <Image
                                src={sourceImage}
                                inferSize
                                widths={responsiveWidths}
                                sizes={responsiveSizes}
                                format="webp"
                                quality={100}
                                alt=""
                                class="demo-final-image"
                                loading="eager"
                                decoding="async"
                                data-progressive-target
                            />
                        </div>
                        <div class="demo-media-overlay"></div>
                        <div class="demo-title-gradient"></div>
                        <div class="demo-tags">
                            <span>文章</span>
                            <span>技术</span>
                        </div>
                        <div class="demo-card-copy">
                            <h3>构建智能家居平台</h3>
                            <p>
                                引言 在上一篇 Homeserver Complete Build Guide
                                中，我们介绍了家庭服务器的基础环境。
                            </p>
                            <time>2025-02-12</time>
                        </div>
                        <div class="demo-loading-state" data-progressive-state>160w · Q45</div>
                    </div>

                    <p class="demo-note">
                        先获得可辨认的真实细节，再按 160w → 480w → 高清逐级替换。
                    </p>
                </article>
            </section>

            <footer class="demo-timeline" aria-live="polite">
                <span class="demo-timeline-dot"></span>
                <strong data-demo-status>准备重播</strong>
                <span data-demo-detail>每一段都是实图，不添加 CSS 模糊。</span>
            </footer>
        </main>

        <script>
            const root = document.querySelector<HTMLElement>('[data-progressive-demo]');

            if (root) {
                const status = root.querySelector<HTMLElement>('[data-demo-status]');
                const detail = root.querySelector<HTMLElement>('[data-demo-detail]');
                const currentState = root.querySelector<HTMLElement>('[data-current-state]');
                const progressiveState = root.querySelector<HTMLElement>(
                    '[data-progressive-state]'
                );
                const mediumTarget = root.querySelector<HTMLImageElement>(
                    '[data-progressive-medium]'
                );
                const target = root.querySelector<HTMLImageElement>('[data-progressive-target]');
                let playbackToken = 0;

                const wait = (duration: number) =>
                    new Promise<void>((resolve) => window.setTimeout(resolve, duration));

                const replay = async () => {
                    const token = ++playbackToken;
                    const delay = Number(root.dataset.delay ?? 1200);
                    const mediumDelay = Math.max(180, Math.round(delay * 0.38));
                    const finalDelay = Math.max(260, delay - mediumDelay);

                    root.dataset.phase = 'low';
                    if (status) status.textContent = '第一段 · 160w 图片';
                    if (detail) detail.textContent = `模拟总延迟 ${Math.round(delay / 100) / 10}s`;
                    if (currentState) currentState.textContent = '等待高清图';
                    if (progressiveState) progressiveState.textContent = '160w · Q45';

                    await wait(80);
                    await wait(mediumDelay);
                    if (token !== playbackToken) return;

                    await mediumTarget?.decode().catch(() => undefined);
                    root.dataset.phase = 'medium';
                    if (status) status.textContent = '第二段 · 480w 图片';
                    if (detail) detail.textContent = '细节提升，仍然不添加模糊滤镜';
                    if (progressiveState) progressiveState.textContent = '480w · Q68';

                    await wait(finalDelay);
                    if (token !== playbackToken) return;

                    root.dataset.phase = 'decoding';
                    if (status) status.textContent = '高清图已返回，正在 decode';
                    if (currentState) currentState.textContent = '图片直接出现';
                    if (progressiveState) progressiveState.textContent = '480w · 高清解码中';

                    await target?.decode().catch(() => undefined);
                    await wait(80);
                    if (token !== playbackToken) return;

                    root.dataset.phase = 'loaded';
                    if (status) status.textContent = '第三段 · 自适应高清图';
                    if (detail) detail.textContent = '160ms 透明度衔接 · 最终 Q100 · 最大 1280w';
                    if (progressiveState) progressiveState.textContent = '自适应高清 · Q100';
                };

                root.querySelectorAll<HTMLButtonElement>('[data-mode-option]').forEach((button) => {
                    button.addEventListener('click', () => {
                        const mode = button.dataset.modeOption;
                        if (!mode) return;
                        root.dataset.mode = mode;
                        root.querySelectorAll<HTMLButtonElement>('[data-mode-option]').forEach(
                            (item) => {
                                item.dataset.active = String(item === button);
                            }
                        );
                        replay();
                    });
                });

                root.querySelectorAll<HTMLButtonElement>('[data-delay-option]').forEach(
                    (button) => {
                        button.addEventListener('click', () => {
                            const delay = button.dataset.delayOption;
                            if (!delay) return;
                            root.dataset.delay = delay;
                            root.querySelectorAll<HTMLButtonElement>('[data-delay-option]').forEach(
                                (item) => {
                                    item.dataset.active = String(item === button);
                                }
                            );
                            replay();
                        });
                    }
                );

                root.querySelector<HTMLButtonElement>('[data-replay]')?.addEventListener(
                    'click',
                    replay
                );
                window.setTimeout(replay, 280);
            }
        </script>
    </body>
</html>

<style is:global>
    :root {
        color-scheme: dark;
        font-family: Inter, 'Noto Sans SC', system-ui, sans-serif;
    }

    * {
        box-sizing: border-box;
    }

    body {
        min-width: 320px;
        min-height: 100svh;
        margin: 0;
        color: #f7f8ff;
        background: #080a11;
    }

    button {
        font: inherit;
    }

    .demo-shell {
        position: relative;
        isolation: isolate;
        min-height: 100svh;
        overflow: hidden;
        padding: clamp(22px, 4vw, 64px);
        background:
            linear-gradient(110deg, #080a11f5 0%, #080a11d9 44%, #080a11f2 100%),
            var(--demo-placeholder) center 36% / cover;
    }

    .demo-shell::before {
        position: absolute;
        inset: -40px;
        z-index: -2;
        background: var(--demo-placeholder) center / cover;
        content: '';
        filter: blur(36px) saturate(0.8);
        opacity: 0.3;
        transform: scale(1.08);
    }

    .demo-shell::after {
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            radial-gradient(circle at 12% 16%, #8d79be2b, transparent 28%),
            radial-gradient(circle at 88% 72%, #62b5d826, transparent 30%),
            linear-gradient(#ffffff07 1px, transparent 1px),
            linear-gradient(90deg, #ffffff07 1px, transparent 1px);
        background-size:
            auto,
            auto,
            56px 56px,
            56px 56px;
        content: '';
        mask-image: linear-gradient(to bottom, black, transparent 92%);
    }

    .demo-header {
        display: grid;
        width: min(100%, 1500px);
        margin: 0 auto;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 32px;
    }

    .demo-kicker {
        margin: 0 0 12px;
        color: #a8b1cf;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.18em;
    }

    h1 {
        max-width: 850px;
        margin: 0;
        font-size: clamp(2rem, 4.2vw, 4.8rem);
        letter-spacing: -0.065em;
        line-height: 0.98;
    }

    h1 span {
        color: #b9c6ff;
    }

    .demo-intro {
        max-width: 760px;
        margin: 18px 0 0;
        color: #b9bfd1;
        font-size: clamp(0.86rem, 1.1vw, 1.05rem);
        line-height: 1.7;
    }

    .demo-controls {
        display: grid;
        justify-items: end;
        gap: 10px;
    }

    .demo-control-group,
    .demo-replay {
        display: flex;
        padding: 4px;
        border: 1px solid #ffffff1f;
        border-radius: 999px;
        background: #101420d9;
        box-shadow: 0 16px 46px #0006;
        backdrop-filter: blur(18px);
    }

    .demo-control-group button,
    .demo-replay {
        border: 0;
        color: #8f97ad;
        cursor: pointer;
    }

    .demo-control-group button {
        min-height: 34px;
        padding: 0 14px;
        border-radius: 999px;
        background: transparent;
        font-size: 0.72rem;
        font-weight: 750;
    }

    .demo-control-group button[data-active='true'] {
        color: #111522;
        background: #eef1ff;
        box-shadow: 0 8px 22px #0005;
    }

    .demo-replay {
        align-items: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 17px;
        color: #eef1ff;
        font-size: 0.76rem;
        font-weight: 800;
    }

    .demo-replay:hover {
        border-color: #a8b9ff75;
        background: #171d2dd9;
    }

    .demo-replay svg {
        width: 17px;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.8;
    }

    .demo-comparison {
        display: grid;
        width: min(100%, 1500px);
        margin: clamp(34px, 5vh, 72px) auto 0;
        grid-template-columns: minmax(0, 1fr) 42px minmax(0, 1fr);
        align-items: center;
        gap: clamp(18px, 3vw, 42px);
    }

    .demo-column {
        display: grid;
        justify-items: center;
        gap: 18px;
    }

    .demo-label-row {
        display: flex;
        width: min(100%, 640px);
        align-items: end;
        justify-content: space-between;
        gap: 12px;
    }

    .demo-label-row > div {
        display: flex;
        align-items: baseline;
        gap: 10px;
    }

    .demo-index {
        color: #778099;
        font-size: 0.66rem;
        font-weight: 850;
        letter-spacing: 0.12em;
    }

    .demo-label-row h2 {
        margin: 0;
        font-size: 1rem;
        letter-spacing: -0.025em;
    }

    .demo-quality {
        padding: 6px 9px;
        border: 1px solid #ffffff20;
        border-radius: 999px;
        color: #969eb4;
        background: #0f131ed9;
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.08em;
    }

    .demo-quality.is-recommended {
        border-color: #9eb3ff5c;
        color: #d5ddff;
        background: #7186db24;
    }

    .demo-card {
        position: relative;
        isolation: isolate;
        width: min(100%, 640px);
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border: 1px solid #ffffff32;
        border-radius: 30px;
        background: linear-gradient(145deg, #283144, #111621);
        box-shadow:
            0 30px 76px #0009,
            inset 0 1px #ffffff25;
        transition:
            width 420ms cubic-bezier(0.22, 1, 0.36, 1),
            aspect-ratio 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-mode='posts'] .demo-card {
        width: min(100%, 420px);
        aspect-ratio: 394 / 720;
    }

    .demo-image-stage,
    .demo-final-image,
    .demo-stage-image,
    .demo-media-overlay,
    .demo-title-gradient {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .demo-image-stage {
        z-index: 0;
        overflow: hidden;
    }

    .demo-final-image,
    .demo-stage-image {
        object-fit: cover;
        object-position: center;
        transform: scale(1.025);
    }

    .demo-final-image {
        opacity: 0;
    }

    .demo-current .demo-final-image {
        transition: opacity 60ms linear;
    }

    [data-phase='decoding'] .demo-current .demo-final-image,
    [data-phase='loaded'] .demo-current .demo-final-image {
        opacity: 1;
    }

    .demo-stage-image {
        image-rendering: auto;
    }

    .demo-stage-low {
        opacity: 1;
        transition: opacity 120ms ease;
    }

    .demo-stage-medium {
        opacity: 0;
        transition: opacity 140ms ease;
    }

    .demo-progressive .demo-final-image {
        transition: opacity 160ms ease;
    }

    [data-phase='medium'] .demo-stage-low,
    [data-phase='decoding'] .demo-stage-low,
    [data-phase='loaded'] .demo-stage-low {
        opacity: 0;
    }

    [data-phase='medium'] .demo-stage-medium,
    [data-phase='decoding'] .demo-stage-medium {
        opacity: 1;
    }

    [data-phase='loaded'] .demo-stage-medium {
        opacity: 0;
    }

    [data-phase='loaded'] .demo-progressive .demo-final-image {
        opacity: 1;
    }

    .demo-media-overlay {
        z-index: 1;
        background:
            linear-gradient(#00000073, #00000073),
            linear-gradient(180deg, #05080f1f 0%, transparent 30%, transparent 48%, #05080f4d 100%);
        pointer-events: none;
    }

    .demo-title-gradient {
        top: auto;
        z-index: 2;
        height: 70%;
        background: linear-gradient(to top, #000000d6, #0007, transparent);
        pointer-events: none;
    }

    .demo-tags {
        position: absolute;
        top: 17px;
        right: 17px;
        left: 17px;
        z-index: 3;
        display: flex;
        justify-content: space-between;
    }

    .demo-tags span {
        padding: 6px 10px;
        border: 1px solid #bcecff80;
        border-radius: 999px;
        color: #f5f8ff;
        background: #79d8ff24;
        box-shadow: 0 4px 14px #0003;
        font-size: 0.65rem;
        font-weight: 800;
        backdrop-filter: blur(12px);
    }

    .demo-tags span:last-child {
        border-color: #d8ff9e70;
        background: #b9f66a20;
    }

    .demo-card-copy {
        position: absolute;
        right: 20px;
        bottom: 18px;
        left: 20px;
        z-index: 3;
        display: grid;
        gap: 9px;
        text-shadow: 0 2px 14px #030712d6;
    }

    .demo-card-copy h3 {
        margin: 0;
        font-size: clamp(1.05rem, 2vw, 1.45rem);
        letter-spacing: -0.03em;
    }

    .demo-card-copy p {
        display: none;
        margin: 0;
        overflow: hidden;
        color: #f3f5fccc;
        font-size: 0.86rem;
        line-height: 1.6;
        text-align: center;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 7;
    }

    .demo-card-copy time {
        color: #d7dce9b8;
        font-size: 0.68rem;
        font-weight: 750;
    }

    [data-mode='posts'] .demo-card-copy {
        top: 25%;
        bottom: 22px;
        align-content: space-between;
        justify-items: center;
        text-align: center;
    }

    [data-mode='posts'] .demo-card-copy p {
        display: -webkit-box;
    }

    .demo-loading-state {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 4;
        padding: 8px 12px;
        border: 1px solid #ffffff28;
        border-radius: 999px;
        color: #e3e7f5;
        background: #080b12bf;
        box-shadow: 0 12px 30px #0007;
        font-size: 0.66rem;
        font-weight: 800;
        opacity: 1;
        transform: translate(-50%, -50%);
        transition: opacity 180ms ease;
        backdrop-filter: blur(12px);
    }

    [data-phase='loaded'] .demo-loading-state {
        opacity: 0;
    }

    .demo-note {
        width: min(100%, 640px);
        margin: 0;
        color: #939bae;
        font-size: 0.73rem;
        line-height: 1.65;
        text-align: center;
    }

    .demo-divider {
        display: grid;
        height: 75%;
        place-items: center;
    }

    .demo-divider::before {
        width: 1px;
        height: 100%;
        background: linear-gradient(transparent, #ffffff24, transparent);
        content: '';
    }

    .demo-divider span {
        position: absolute;
        display: grid;
        width: 42px;
        aspect-ratio: 1;
        place-items: center;
        border: 1px solid #ffffff20;
        border-radius: 50%;
        color: #7f879c;
        background: #0a0d15;
        font-size: 0.63rem;
        font-weight: 900;
    }

    .demo-timeline {
        display: flex;
        width: min(100%, 620px);
        margin: clamp(28px, 4vh, 48px) auto 0;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #8f97aa;
        font-size: 0.72rem;
        text-align: center;
    }

    .demo-timeline strong {
        color: #edf0fb;
    }

    .demo-timeline-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #8da3ff;
        box-shadow: 0 0 18px #8da3ff;
    }

    [data-phase='low'] .demo-timeline-dot,
    [data-phase='medium'] .demo-timeline-dot,
    [data-phase='decoding'] .demo-timeline-dot {
        animation: demo-pulse 1s ease-in-out infinite;
    }

    @keyframes demo-pulse {
        50% {
            opacity: 0.35;
            transform: scale(0.78);
        }
    }

    @media (max-width: 1100px) {
        .demo-header {
            grid-template-columns: 1fr;
        }

        .demo-controls {
            justify-items: start;
        }

        .demo-comparison {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        }

        .demo-divider {
            display: none;
        }
    }

    @media (max-width: 620px) {
        .demo-shell {
            padding: 22px 16px 38px;
        }

        .demo-controls {
            width: 100%;
            justify-items: stretch;
        }

        .demo-control-group {
            justify-content: stretch;
        }

        .demo-control-group button {
            flex: 1;
            padding-inline: 8px;
        }

        .demo-replay {
            justify-content: center;
        }

        .demo-comparison {
            grid-template-columns: 1fr;
